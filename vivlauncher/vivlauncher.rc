LANGUAGE 9, 1

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.

IDI_VIVLAUNCHER       ICON         "vivlauncher.ico"
IDI_SMALL               ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_VIVLAUNCHER MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_VIVLAUNCHER ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About vivlauncher"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDI_VIVLAUNCHER,IDC_STATIC,14,14,21,20
    LTEXT           "vivlauncher, Version 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (c) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_VERSION_SELECTOR DIALOGEX 0, 0, 260, 100
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUPWINDOW | WS_CAPTION | WS_SYSMENU
CAPTION "Select Vivado Version"
FONT 12, "MS Shell Dlg"
BEGIN
    LISTBOX         IDC_VERSION_LIST,2,2,256,96,LBS_NOTIFY | LBS_SORT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
END

IDD_ADD_PATH DIALOGEX 0, 0, 380, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Vivado Path"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Enter Vivado installation path:",IDC_STATIC,14,14,350,12
    EDITTEXT        IDC_PATH_EDIT,14,30,260,20,WS_BORDER | ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BROWSE_BUTTON,282,29,80,22
    DEFPUSHBUTTON   "Add",IDOK,200,68,75,20,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,283,68,75,20
END

IDD_MAIN_DIALOG DIALOGEX 0, 0, 560, 350
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "vivlauncher"
FONT 9, "MS Shell Dlg"
BEGIN
    CONTROL         "",IDC_MAIN_TABS,"SysTabControl32",WS_TABSTOP,8,8,544,145
    LTEXT           "Vivado project:",IDC_PROJECT_LABEL,20,40,90,12
    EDITTEXT        IDC_PROJECT_PATH,20,56,430,20,WS_BORDER | ES_AUTOHSCROLL
    PUSHBUTTON      "Browse",IDC_BROWSE_PROJECT,455,55,85,22
    LTEXT           "Recent projects:",IDC_RECENT_LABEL,20,84,100,12
    LISTBOX         IDC_RECENT_PROJECTS,20,100,520,45,LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Vivado installations:",IDC_INSTALL_LABEL,20,195,130,12
    LISTBOX         IDC_INSTALL_LIST,20,211,520,48,LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Refresh",IDC_REFRESH_INSTALLS,20,265,65,22
    PUSHBUTTON      "Add path",IDC_ADD_INSTALL,90,265,75,22
    PUSHBUTTON      "Set default",IDC_SET_DEFAULT,170,265,85,22
    LTEXT           "Launch options:",IDC_OPTIONS_LABEL,20,195,100,12
    AUTOCHECKBOX    "No log",IDC_NO_LOG,20,214,70,16
    AUTOCHECKBOX    "No journal",IDC_NO_JOURNAL,95,214,85,16
    LTEXT           "Additional arguments:",IDC_ADDITIONAL_LABEL,20,242,130,12
    EDITTEXT        IDC_EXTRA_ARGS,20,258,520,20,WS_BORDER | ES_AUTOHSCROLL
    CONTROL         "",IDC_LOWER_TABS,"SysTabControl32",WS_TABSTOP,8,165,544,125
    LTEXT           "Diagnostics",IDC_DIAGNOSTIC_LABEL,20,40,100,12
    PUSHBUTTON      "View log",IDC_VIEW_LOG,20,65,75,22
    PUSHBUTTON      "Log folder",IDC_OPEN_LOG_FOLDER,100,65,85,22
    PUSHBUTTON      "Clear recent",IDC_CLEAR_RECENT,190,65,95,22
    PUSHBUTTON      "Config folder",IDC_OPEN_CONFIG_FOLDER,290,65,95,22
    LTEXT           "Log file:",IDC_LOG_LABEL,20,100,60,12
    EDITTEXT        IDC_LOG_PATH,80,96,455,20,ES_READONLY | WS_BORDER | ES_AUTOHSCROLL
    LTEXT           "Config:",IDC_CONFIG_LABEL,20,130,60,12
    EDITTEXT        IDC_CONFIG_PATH,80,126,455,20,ES_READONLY | WS_BORDER | ES_AUTOHSCROLL
    LTEXT           "Help",IDC_HELP_LABEL,20,40,100,12
    EDITTEXT        IDC_HELP_TEXT,20,58,520,87,ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_BORDER
    PUSHBUTTON      "Bind project",IDC_BIND_PROJECT,265,305,85,22
    PUSHBUTTON      "Associate .xpr",IDC_REGISTER_XPR,20,95,105,22
    DEFPUSHBUTTON   "Open project",IDC_OPEN_PROJECT,390,305,100,22
    PUSHBUTTON      "Cancel",IDCANCEL,495,305,45,22
END

